/*
 * FinanceApp - QSS 主题样式表
 * 简洁现代风格，蓝色主色调
 */

/* ── 全局 ── */
QWidget {
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 13px;
}

QMainWindow {
    /* 默认纯色背景：当用户关闭自定义背景时生效 */
    background-color: #f5f7fa;
}

/* ── 自定义背景层（位于所有内容之下） ── */
#bgLayer {
    background: transparent;
    /* WA_TransparentForMouseEvents 已通过代码设置，
       这里确保背景图不响应任何鼠标事件 */
}

/* ── 侧边栏 ──
   使用 rgba 半透明深色：保留导航清晰度的同时让背景图片微透出来 */
#sidebar {
    background-color: rgba(30, 41, 59, 230);
    border: none;
}

#sidebar QLabel {
    color: #ffffff;
    font-size: 16px;
    font-weight: bold;
    padding: 16px 16px 8px 16px;
}

#sidebar::separator {
    height: 1px;
    background: #334155;
    margin: 4px 12px;
}

/* ── 侧边栏按钮 ── */
#sidebar QPushButton {
    background-color: transparent;
    color: #cbd5e1;
    border: none;
    border-radius: 8px;
    padding: 10px 16px;
    text-align: left;
    font-size: 14px;
    margin: 2px 8px;
}

#sidebar QPushButton:hover {
    background-color: #334155;
    color: #ffffff;
}

#sidebar QPushButton:checked {
    background-color: #3b82f6;
    color: #ffffff;
    font-weight: bold;
}

/* ── 内容区 ──
   半透明浅色：让背景图片透出来，但保持轻微的浅色滤镜保证页面分区感 */
#contentArea {
    background-color: rgba(245, 247, 250, 110);
    border: none;
}

/* ── 卡片 ── */
QFrame#card {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 16px;
}

/* ── 概览卡片 ── */
QLabel#overviewCard {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 20px;
    font-size: 14px;
}

QLabel#overviewValue {
    font-size: 24px;
    font-weight: bold;
    padding-top: 4px;
}

QLabel#incomeValue {
    color: #22c55e;
}

QLabel#expenseValue {
    color: #ef4444;
}

QLabel#balanceValue {
    color: #3b82f6;
}

/* ── 表格 ── */
QTableWidget {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    gridline-color: #f1f5f9;
    selection-background-color: #eff6ff;
    selection-color: #1e40af;
    font-size: 13px;
}

QTableWidget::item {
    padding: 8px;
    border-bottom: 1px solid #f1f5f9;
}

QHeaderView::section {
    background-color: #f8fafc;
    color: #475569;
    font-weight: bold;
    padding: 10px 8px;
    border: none;
    border-bottom: 2px solid #e2e8f0;
    font-size: 13px;
}

/* ── 按钮通用 ── */
QPushButton {
    background-color: #3b82f6;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 8px 20px;
    font-size: 13px;
    font-weight: bold;
    min-height: 20px;
}

QPushButton:hover {
    background-color: #2563eb;
}

QPushButton:pressed {
    background-color: #1d4ed8;
}

QPushButton#dangerBtn {
    background-color: #ef4444;
    border: none;
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 13px;
    font-weight: bold;
}

QPushButton#dangerBtn:hover {
    background-color: #dc2626;
}

QPushButton#secondaryBtn {
    background-color: #ffffff;
    color: #374151;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 13px;
    font-weight: bold;
}

QPushButton#secondaryBtn:hover {
    background-color: #f9fafb;
    border-color: #9ca3af;
}

QPushButton#addBtn {
    background-color: #22c55e;
}

QPushButton#addBtn:hover {
    background-color: #16a34a;
}

/* ── 输入框 ── */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 13px;
    color: #1f2937;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border: 2px solid #3b82f6;
    background-color: #eff6ff;
}

QComboBox::drop-down {
    border: none;
    width: 30px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    selection-background-color: #eff6ff;
    selection-color: #1e40af;
}

/* ── 日期编辑器 ── */
QDateEdit {
    background-color: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 13px;
    color: #1f2937;
}

QDateEdit::drop-down {
    border: none;
    width: 30px;
}

/* ── 文本框 ── */
QTextEdit {
    background-color: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 13px;
    color: #1f2937;
}

QTextEdit:focus {
    border: 2px solid #3b82f6;
    background-color: #eff6ff;
}

/* ── 单选按钮 ── */
QRadioButton {
    font-size: 14px;
    spacing: 8px;
    padding: 4px;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    border: 2px solid #d1d5db;
    background-color: #ffffff;
}

QRadioButton::indicator:checked {
    border: 2px solid #3b82f6;
    background-color: #3b82f6;
}

/* ── 对话框 ── */
QDialog {
    background-color: #f5f7fa;
}

QDialogButtonBox QPushButton {
    min-width: 80px;
}

/* ── 标签 ── */
QLabel#sectionTitle {
    font-size: 18px;
    font-weight: bold;
    color: #1e293b;
    padding: 0 0 8px 0;
}

QLabel#fieldLabel {
    font-size: 13px;
    font-weight: bold;
    color: #475569;
    padding: 0 0 4px 0;
}

/* ── 筛选区 ── */
QFrame#filterBar {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 12px;
}

/* ── 滚动条 ── */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #cbd5e1;
    min-height: 30px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #94a3b8;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

/* ── 消息框 ── */
QMessageBox {
    background-color: #ffffff;
}

/* ── 日历页面 ── */

/* 头部：保持白色实色保证文字清晰，但允许头部透明以微微透出背景 */
#calendarHeader {
    background-color: rgba(255, 255, 255, 220);
    border-bottom: 1px solid #e2e8f0;
    border-radius: 8px;
}

#calendarMonthLabel {
    font-size: 20px;
    font-weight: bold;
    color: #1e293b;
}

#calendarMonthSummary {
    font-size: 13px;
    color: #475569;
    padding: 2px 0;
}

#calendarNavBtn {
    background-color: #f1f5f9;
    color: #475569;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    font-size: 14px;
    font-weight: bold;
    min-width: 20px;
    padding: 4px;
}

#calendarNavBtn:hover {
    background-color: #e2e8f0;
    color: #1e293b;
}

/* 网格区域 */
#calendarGridArea {
    background-color: rgba(255, 255, 255, 180);
    border-radius: 8px;
}

#weekdayHeader {
    font-size: 12px;
    font-weight: bold;
    color: #94a3b8;
    background-color: transparent;
}

/* 日期格子 */
#dayCell {
    background-color: #ffffff;
    border: 1px solid #f1f5f9;
    border-radius: 8px;
}

#dayCell:hover {
    background-color: #f0fdf4;
    border-color: #bbf7d0;
}

#dayCell[selected="true"] {
    background-color: #dcfce7;
    border: 2px solid #22c55e;
}

#dayNumber {
    font-size: 14px;
    font-weight: bold;
    color: #1e293b;
    padding: 0;
    margin: 0;
}

#dayNumberToday {
    font-size: 14px;
    font-weight: bold;
    color: #ffffff;
    background-color: #22c55e;
    border-radius: 10px;
    padding: 0 4px;
    margin: 0;
}

#dayIncome {
    font-size: 10px;
    color: #10b981;
    padding: 0;
    margin: 0;
}

#dayExpense {
    font-size: 10px;
    color: #ef4444;
    padding: 0;
    margin: 0;
}

#dayLunar {
    font-size: 9px;
    color: #94a3b8;
    padding: 0;
    margin: 0;
}

/* 分隔线 */
#calendarSeparator {
    background-color: #e2e8f0;
    max-height: 1px;
}

/* 明细区域 */
#calendarDetailArea {
    background-color: rgba(255, 255, 255, 220);
    border-radius: 8px;
}

#calendarDaySummary {
    font-size: 14px;
    color: #475569;
    padding: 4px 0;
}

#calendarDetailScroll {
    background-color: transparent;
    border: none;
}

#emptyDetailLabel {
    color: #94a3b8;
    font-size: 13px;
}

/* 账单明细行 */
#transactionItem {
    background-color: #ffffff;
    border-bottom: 1px solid #f1f5f9;
    border-radius: 0;
}

#transactionItem:hover {
    background-color: #f8fafc;
}

#txCategoryLabel {
    font-size: 13px;
    color: #1e293b;
}

#txNoteLabel {
    font-size: 12px;
    color: #94a3b8;
}

#txAmountLabel {
    font-size: 14px;
    font-weight: bold;
}

/* ═════════════════════════════════════════════════════════════════════
   背景设置对话框专用样式
   ═════════════════════════════════════════════════════════════════════ */

/* 主按钮：和普通 QPushButton 风格一致，已在通用样式中定义 */
/* 这里单独给主按钮一个明确的命名，便于对话框使用 */

/* ── 缩略图卡片 ── */
#bgThumbCard {
    background-color: #ffffff;
    border: 2px solid #e2e8f0;
    border-radius: 10px;
}

#bgThumbCard:hover {
    border-color: #94a3b8;
}

#bgThumbCard[selected="true"] {
    border-color: #3b82f6;
    background-color: #eff6ff;
}

/* 缩略图卡片内嵌的单选按钮（紧凑显示） */
#bgThumbRadio {
    font-size: 13px;
    color: #1e293b;
    spacing: 4px;
}

#bgThumbRadio::indicator {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    border: 2px solid #cbd5e1;
    background-color: #ffffff;
}

#bgThumbRadio::indicator:hover {
    border-color: #3b82f6;
}

#bgThumbRadio::indicator:checked {
    border: 2px solid #3b82f6;
    background-color: #3b82f6;
}

/* ── 透明度数值显示 ── */
#opacityValue {
    font-size: 13px;
    font-weight: bold;
    color: #1e293b;
    font-family: "Consolas", "Courier New", monospace;
}

/* ── 实时预览区域 ── */
#bgPreview {
    background-color: #f1f5f9;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    /* 预览尺寸固定，无需缩放 */
}
